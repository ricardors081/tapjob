{
  "agent-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python tools/agent_guard/pre_tool_guard.py",
            "timeout": 30
          }
        ]
      }
    ]
  }
}

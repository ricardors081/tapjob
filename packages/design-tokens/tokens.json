{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Canonical TapJob design tokens (DTCG Format 2025.10). Values follow the initial baseline in docs/DESIGN_SYSTEM.md. The `primitive` group is raw scale/palette and is not exported to platforms; feature code consumes semantic tokens only.",
  "primitive": {
    "color": {
      "$type": "color",
      "$description": "sRGB colors per DTCG Color Module 2025.10: components in [0, 1]; `hex` is the 6-digit fallback and must match the components.",
      "white": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#FFFFFF" } },
      "blue": {
        "600": {
          "$value": {
            "colorSpace": "srgb",
            "components": [0.1451, 0.3882, 0.9216],
            "hex": "#2563EB"
          }
        },
        "700": {
          "$value": {
            "colorSpace": "srgb",
            "components": [0.1137, 0.3059, 0.8471],
            "hex": "#1D4ED8"
          }
        }
      },
      "orange": {
        "500": {
          "$value": {
            "colorSpace": "srgb",
            "components": [0.9765, 0.451, 0.0863],
            "hex": "#F97316"
          }
        }
      },
      "green": {
        "600": {
          "$value": {
            "colorSpace": "srgb",
            "components": [0.0863, 0.6392, 0.2902],
            "hex": "#16A34A"
          }
        }
      },
      "amber": {
        "600": {
          "$value": {
            "colorSpace": "srgb",
            "components": [0.851, 0.4667, 0.0235],
            "hex": "#D97706"
          }
        }
      },
      "red": {
        "600": {
          "$value": { "colorSpace": "srgb", "components": [0.8627, 0.149, 0.149], "hex": "#DC2626" }
        }
      },
      "sky": {
        "600": {
          "$value": {
            "colorSpace": "srgb",
            "components": [0.0078, 0.5176, 0.7804],
            "hex": "#0284C7"
          }
        }
      },
      "slate": {
        "50": {
          "$value": {
            "colorSpace": "srgb",
            "components": [0.9725, 0.9804, 0.9882],
            "hex": "#F8FAFC"
          }
        },
        "200": {
          "$value": {
            "colorSpace": "srgb",
            "components": [0.8863, 0.9098, 0.9412],
            "hex": "#E2E8F0"
          }
        },
        "600": {
          "$value": {
            "colorSpace": "srgb",
            "components": [0.2784, 0.3333, 0.4118],
            "hex": "#475569"
          }
        },
        "900": {
          "$value": {
            "colorSpace": "srgb",
            "components": [0.0588, 0.0902, 0.1647],
            "hex": "#0F172A"
          }
        }
      }
    },
    "space": {
      "$type": "dimension",
      "$description": "4-point spacing foundation; step N = N x 4px. Semantic spacing names are mapped in the design-system workstream.",
      "1": { "$value": { "value": 4, "unit": "px" } },
      "2": { "$value": { "value": 8, "unit": "px" } },
      "3": { "$value": { "value": 12, "unit": "px" } },
      "4": { "$value": { "value": 16, "unit": "px" } },
      "5": { "$value": { "value": 20, "unit": "px" } },
      "6": { "$value": { "value": 24, "unit": "px" } },
      "8": { "$value": { "value": 32, "unit": "px" } },
      "10": { "$value": { "value": 40, "unit": "px" } },
      "12": { "$value": { "value": 48, "unit": "px" } },
      "16": { "$value": { "value": 64, "unit": "px" } }
    }
  },
  "spacing": {
    "$type": "dimension",
    "$description": "Semantic layout spacing scale; aliases the primitive 4-point foundation.",
    "xs": { "$value": "{primitive.space.1}" },
    "sm": { "$value": "{primitive.space.2}" },
    "md": { "$value": "{primitive.space.3}" },
    "lg": { "$value": "{primitive.space.4}" },
    "xl": { "$value": "{primitive.space.6}" }
  },
  "radius": {
    "$type": "dimension",
    "none": { "$value": { "value": 0, "unit": "px" } },
    "sm": { "$value": { "value": 8, "unit": "px" } },
    "md": { "$value": { "value": 12, "unit": "px" } },
    "lg": { "$value": { "value": 16, "unit": "px" } },
    "xl": { "$value": { "value": 24, "unit": "px" } },
    "full": {
      "$description": "Pill/circle: large enough to fully round any component.",
      "$value": { "value": 9999, "unit": "px" }
    }
  },
  "borderWidth": {
    "$type": "dimension",
    "hairline": { "$value": { "value": 1, "unit": "px" } }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": { "value": 160, "unit": "ms" } },
      "standard": { "$value": { "value": 220, "unit": "ms" } },
      "emphasis": { "$value": { "value": 320, "unit": "ms" } }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "$description": "`primary` names the brand typeface (docs/DESIGN_SYSTEM.md §3). The `primary*` weight variants are the specific font-family names React Native resolves once apps/mobile loads them with useFonts: Expo SDK 57 does not yet support combining one family name with the `fontWeight` style prop for a loaded custom font (SDK 58+ does), so each loaded weight is its own family name here.",
      "primary": { "$value": "Inter" },
      "primaryRegular": { "$value": "Inter_400Regular" },
      "primarySemibold": { "$value": "Inter_600SemiBold" },
      "primaryBold": { "$value": "Inter_700Bold" }
    },
    "fontSize": {
      "$type": "dimension",
      "$description": "Minimal semantic type scale for the mobile shell; extend when the design-system workstream defines the full scale (docs/DESIGN_SYSTEM.md §5).",
      "body": { "$value": { "value": 16, "unit": "px" } },
      "title": { "$value": { "value": 24, "unit": "px" } },
      "heading": { "$value": { "value": 28, "unit": "px" } }
    }
  }
}

                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "O provedor de identidade não pôde ser contatado."
          }
        },
        "summary": "Revoke All Sessions",
        "tags": [
          "identity"
        ]
      }

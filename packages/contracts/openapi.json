      "ValidationErrorItem": {
        "description": "One field-level validation failure. Carries only a normalized ``code`` (Pydantic's error\n``type``) plus ``location``, never the raw ``input``/``ctx``/``msg``: those can echo request\ndata -- including personal data -- back into the error body.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "location": {
            "items": {
              "type": "string"
            },
            "title": "Location",
            "type": "array"
          }
        },
        "required": [
          "location",
          "code"
        ],
        "title": "ValidationErrorItem",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "TapJob API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/bootstrap": {
      "post": {
        "description": "Resolves the caller's existing TapJob `User` for this verified Firebase identity, or creates\none (plus its `ExternalIdentity` link) if this is the first time this identity has ever\nauthenticated. Idempotent and concurrency-safe (`service.bootstrap_user`); never auto-links to\na different `User` based on email. The `ACCOUNT_CREATED` audit row (when `created`) commits in\nthe SAME transaction as the new `User`/`ExternalIdentity` rows -- never a separate, later\ncommit that could leave a `User` durably created with no corresponding audit row (2026\nindependent-review \"account-created audit transaction\").",
        "operationId": "bootstrapAccount",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BootstrapResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Token ausente, inválido, expirado ou revogado."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Muitas requisições."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Erro interno inesperado."
          }
        },
        "summary": "Bootstrap Account",
        "tags": [
          "identity"
        ]
      }
    },

    "/api/v1/me/sessions/revoke-all": {
      "post": {
        "description": "Revokes every Firebase refresh token for this account's linked identity (global, not\nper-device -- docs/adr/0009-...md \"per-device session revocation\"). The audit row reflects the\nACTUAL provider outcome: a success row is written only after Firebase confirms the revocation,\nand a failed provider call is recorded as a failure, never silently dropped\n(docs/adr/0009-...md \"audit transaction semantics\"). Because `IdentityTokenVerifier` always\nverifies with `check_revoked=True` (see `tapjob_api.identity.firebase`'s module docstring,\ncorrected 2026 independent-review finding 5), this backend rejects an already-issued ID token\non the very next request after this call, not merely after that token's own natural expiry --\nthe only thing that can lag is the CLIENT noticing (its local Firebase SDK session keeps using\nits cached token until it next refreshes or itself observes revocation); this endpoint's own\nserver-side enforcement is immediate.",
        "operationId": "revokeAllSessions",
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Autenticação recente é necessária para esta ação."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conta desativada."
          },

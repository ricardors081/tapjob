    "/api/v1/me/deletion-request": {
      "delete": {
        "description": "Security-sensitive in exactly the same way as requesting deletion -- recent authentication\nand rate limiting apply here too (docs/adr/0009-...md \"sensitive action / recent auth\",\n2026 independent-review finding 3). Only a REQUESTED request is cancellable: once\nPROCESSING/COMPLETED/FAILED, this is a 409, never a silent no-op or a false \"cancelled\".",
        "operationId": "cancelAccountDeletion",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeletionRequestResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Autenticação recente é necessária para esta ação."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conta desativada."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conta ainda não inicializada."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Não há solicitação de exclusão cancelável (inexistente ou já em processamento)."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Muitas requisições."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Erro interno inesperado."
          }
        },
        "summary": "Cancel Account Deletion",
        "tags": [
          "identity"
        ]
      },
      "get": {
        "operationId": "getAccountDeletionRequest",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/DeletionRequestResponse"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "title": "Response Getaccountdeletionrequest"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Token ausente, inválido, expirado ou revogado."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conta desativada."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conta ainda não inicializada."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Erro interno inesperado."
          }
        },
        "summary": "Get Account Deletion Request",
        "tags": [
          "identity"
        ]
      },
      "post": {
        "description": "202 Accepted, not 200/204: this only SCHEDULES/records a request -- it never claims data was\ndeleted (docs/adr/0009-...md \"deletion endpoint\"). Idempotent: a second call while one is\nalready active returns the existing request rather than creating a duplicate.",
        "operationId": "requestAccountDeletion",
        "responses": {
          "202": {
            "content": {
              "application/json": {

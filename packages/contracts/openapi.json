{
  "components": {
    "schemas": {
      "DependencyName": {
        "enum": [
          "postgresql",
          "redis"
        ],
        "title": "DependencyName",
        "type": "string"
      },
      "DependencyStatus": {
        "enum": [
          "ok",
          "unavailable"
        ],
        "title": "DependencyStatus",
        "type": "string"
      },
      "Environment": {
        "enum": [
          "local",
          "development",
          "staging",
          "production"
        ],
        "title": "Environment",
        "type": "string"
      },
      "ErrorCode": {
        "description": "Machine-readable error vocabulary. Clients localize/branch on this, never on ``message``.",
        "enum": [
          "INVALID_REQUEST",
          "VALIDATION_FAILED",
          "AUTHENTICATION_REQUIRED",
          "PERMISSION_DENIED",
          "RESOURCE_NOT_FOUND",
          "METHOD_NOT_ALLOWED",
          "CONFLICT",
          "RATE_LIMITED",
          "SERVICE_UNAVAILABLE",
          "UPSTREAM_FAILED",
          "UPSTREAM_TIMEOUT",
          "INVALID_CURSOR",
          "INTERNAL_ERROR"
        ],
        "title": "ErrorCode",
        "type": "string"
      },
      "ErrorResponse": {
        "description": "Canonical envelope for every non-2xx response (docs/ENGINEERING_STANDARDS.md §8).",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "details": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ValidationErrorItem"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errors"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "requestId": {
            "title": "Requestid",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "requestId"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "environment": {
            "$ref": "#/components/schemas/Environment"
          },
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/HealthStatus"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service",
          "version",
          "environment"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "HealthStatus": {
        "enum": [
          "ok"
        ],
        "title": "HealthStatus",
        "type": "string"
      },
      "ReadinessResponse": {
        "properties": {
          "dependencies": {
            "additionalProperties": {
              "$ref": "#/components/schemas/DependencyStatus"
            },
            "propertyNames": {
              "$ref": "#/components/schemas/DependencyName"
            },
            "title": "Dependencies",
            "type": "object"
          },
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/ReadinessStatus"
          }
        },
        "required": [
          "status",
          "service",
          "dependencies"
        ],
        "title": "ReadinessResponse",
        "type": "object"
      },
      "ReadinessStatus": {
        "enum": [
          "ok",
          "degraded"
        ],
        "title": "ReadinessStatus",
        "type": "string"
      },
      "ValidationErrorItem": {
        "description": "One field-level validation failure. Carries only a normalized ``code`` (Pydantic's error\n``type``) plus ``location``, never the raw ``input``/``ctx``/``msg``: those can echo request\ndata -- including personal data -- back into the error body.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "location": {
            "items": {
              "type": "string"
            },
            "title": "Location",
            "type": "array"
          }
        },
        "required": [
          "location",
          "code"
        ],
        "title": "ValidationErrorItem",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "TapJob API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Erro interno inesperado."
          }
        },
        "summary": "Get Health",
        "tags": [
          "health"
        ]
      }
    },
    "/ready": {
      "get": {
        "operationId": "getReadiness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Erro interno inesperado."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Uma ou mais dependências estão indisponíveis."
          }
        },
        "summary": "Get Readiness",
        "tags": [
          "health"
        ]
      }
    }
  }
}

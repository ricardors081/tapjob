# Local Docker Compose environment. Copy to infra/.env (git-ignored) and adjust.
# These are LOCAL DEVELOPMENT values only. Staging/production secrets never live in the repository.

# Runtime environment: local | development | staging | production
APP_ENV=local
LOG_LEVEL=INFO

# PostgreSQL (local container). The password must be URL-safe because it is embedded in DATABASE_URL.
POSTGRES_USER=tapjob
POSTGRES_DB=tapjob
POSTGRES_PASSWORD=local-dev-only-change-me

# Host ports, bound to 127.0.0.1 only.
API_HOST_PORT=8000
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

# Optional. Sentry stays disabled when unset (never set in local development or CI).
# SENTRY_DSN=
# Optional JSON array of configured ATS boards for scheduled worker ingestion (WP2.1-B).
# HOSTED_ATS_SOURCES=

# Messaging Gateway (Evolution API) & WhatsApp webhook settings (local development defaults)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=test-key
EVOLUTION_INSTANCE_NAME=tapjob
WHATSAPP_WEBHOOK_ENABLED=false
WHATSAPP_WEBHOOK_SECRET=local-dev-webhook-secret

# AI Provider (local development default: deterministic; staging/production: openai)
AI_PROVIDER=deterministic



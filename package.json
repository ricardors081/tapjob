{
  "name": "tapjob-monorepo",
  "private": true,
  "description": "JavaScript/TypeScript workspace root. Python services use the uv workspace in pyproject.toml.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/design-tokens",
    "packages/product-config",
    "packages/contracts",
    "apps/mobile"
  ],
  "scripts": {
    "tokens:build": "npm run build --workspace @tapjob/design-tokens",
    "tokens:check": "npm run check --workspace @tapjob/design-tokens",
    "contracts:generate": "npm run generate --workspace @tapjob/contracts",
    "security:audit-gate": "node tools/security/audit-gate.mjs",
    "security:audit-gate:test": "node --test tools/security/audit-gate.test.mjs",
    "deploy:validate-image": "node tools/deploy/validate_image_ref.mjs",
    "deploy:validate-image:test": "node --test tools/deploy/validate_image_ref.test.mjs",
    "deploy:require-ci-success:test": "node --test tools/deploy/require_ci_success.test.mjs",
    "deploy:require-pr-ci-success:test": "node --test tools/deploy/require_pr_ci_success.test.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && npm run security:audit-gate:test && npm run deploy:validate-image:test && npm run deploy:require-ci-success:test && npm run deploy:require-pr-ci-success:test",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "governance:validate": "python tools/agent_guard/validate_governance.py",
    "governance:test": "python -m unittest discover -s tools/agent_guard -p \"test_*.py\"",
    "agent-factory:test": "python -m unittest discover -s tools/agent_factory -p \"test_*.py\"",
    "check:js": "npm run tokens:check && npm run lint && npm run format:check && npm run typecheck && npm test",
    "check:py": "uv run ruff check . && uv run ruff format --check . && uv run python -m mypy && uv run python -m pytest",
    "check": "npm run check:js && npm run check:py && npm run governance:validate && npm run governance:test && npm run agent-factory:test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-expo": "57.0.2",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "overrides": {
    "react": "19.2.3",
    "@hey-api/json-schema-ref-parser": {
      "js-yaml": "4.3.2"
    },
    "@grpc/grpc-js": "1.14.5"
  }
}

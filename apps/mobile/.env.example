# Local development values for the Expo app. Copy to apps/mobile/.env (git-ignored).
# Every EXPO_PUBLIC_* variable is bundled into the client and is public: never put a secret here
# (docs/ENGINEERING_STANDARDS.md §3.3). Read only through src/config/public-config.ts.

# Runtime environment: local | development | staging | production
EXPO_PUBLIC_APP_ENV=local

# Backend API base URL. 10.0.2.2 is the Android emulator's alias for the host machine's
# localhost; use your LAN IP for a physical device, or http://localhost:8000 for iOS Simulator/web.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional. Sentry DSNs are public by design. Leave unset to keep Sentry disabled (default in
# local development and CI).
# EXPO_PUBLIC_SENTRY_DSN=

# Optional. The Google OAuth "Web client ID" from the real Firebase project's console (not a
# secret, but environment-specific). Leave unset until a real Firebase project is configured --
# Google sign-in then fails closed with a clear error instead of silently misconfiguring the SDK.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

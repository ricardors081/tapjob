{
  "name": "@tapjob/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Expo/React Native shell: proves app boot, Expo Router, design tokens, product config, i18n and typed public config (WP0.1-B); minimal Firebase auth technical surface (WP1.1).",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "doctor": "expo-doctor",
    "export": "expo export --platform android --platform ios",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@react-native-firebase/app": "^26.4.0",
    "@react-native-firebase/auth": "^26.4.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@sentry/react-native": "~7.11.0",
    "@tapjob/contracts": "*",
    "@tapjob/design-tokens": "*",
    "@tapjob/product-config": "*",
    "expo": "~57.0.27",
    "expo-apple-authentication": "~57.0.2",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.13",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "i18next": "^26.4.2",
    "react": "19.2.3",
    "react-i18next": "^17.0.15",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "jest": {
    "preset": "jest-expo",
    "testTimeout": 15000,
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ]
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "^24.19.0",
    "@types/react": "~19.2.4",
    "jest": "~29.7.0",
    "jest-expo": "~58.0.11"
  },
  "expo": {
    "install": {
      "exclude": [
        "expo",
        "expo-crypto",
        "expo-dev-client",
        "expo-router",
        "expo-splash-screen",
        "jest-expo"
      ]
    }
  }
}
